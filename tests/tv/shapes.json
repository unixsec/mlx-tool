 "ps.pgid.narrow": {
  "scenario": "对 **pgid 位数少于字段宽度**的进程查 pgid（pid 1 的 pgid 通常是 1）",
  "argv_template": [
   "ps",
   "-o",
   "pgid=",
   "-p",
   "1"
  ],
  "stability": "shape-only",
  "rc": 0,
  "shape": {
   "rc": 0,
   "stdout_re": "^ *\\d+\\n$",
   "field_width": 5,
   "align": "right"
  },
  "sample_stdout_b64": "ICAgIDEK",
  "sample_stderr_b64": "",
  "note": "**BCR-4-04 的前提「无前导空格」为假**：字段宽度固定 5、右对齐 ⇒ pgid 位数 <5 时有前导空格。实测 pgid of 1 = b'    1\\n'，pgid of 五位数 = 无前导空格。前两次录制都碰巧录到 5 位数因此未发现。坏样本 int(b' 6477\\n') **不抛异常** ⇒ 依赖「解析失败」的守卫恒绿，必须改为断言字节形态。",
  "scenario_key": "narrow",
  "command": "ps -o pgid=",
  "pending": false,
  "provenance": "recorded"
 },
 "lsof.badexec": {
  "scenario": "**`MLX_BIN_LSOF` 指向的二进制可执行、但拒绝该组参数**（rc≠0 ∧ stdout 空 ∧ stderr 非空）。**不写成「非数字端口」** —— `port: int`，产品永不产生那种 argv（裁决 R5-2）。断言只针对三通道形态，不针对此处的具体 argv。",
  "scenario_key": "badexec",
  "command": "lsof",
  "argv_template": [
   "lsof",
   "--badopt"
  ],
  "stability": "shape-only",
  "rc": 1,
  "shape": {
   "rc_nonzero": true,
   "stdout_empty": true,
   "stderr_nonempty": true,
   "stderr_re": "^lsof: "
  },
  "sample_stdout_b64": "",
  "sample_stderr_b64": "",
  "note": "裁决 R5-2 补录：「跑完了但失败」态。此前 lsof/df/vm_stat 三个命令该列零夹具、零用例、零开口登记。",
  "pending": false,
  "provenance": "recorded"
 },
 "df.badpath": {
  "scenario": "`df` 跑完但失败：rc=1 + stdout 空 + stderr 非空。消费者若写 `splitlines()[1]` 会抛 `IndexError` 穿透成 `Failed(1)`，写 `except: return Ok(0)` 则磁盘余量恒 0 ⇒ `fitness` 恒 `OVER` ⇒ `install` 恒拒绝（裁决 R5-2）。",
  "scenario_key": "badpath",
  "command": "df -k",
  "argv_template": [
   "df",
   "-k",
   "/no/such/path"
